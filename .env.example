# LLM
OPENAI_API_KEY=sk-your-openai-api-key
# For compatible APIs (e.g. opencode go), set a custom base URL:
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Search - Tavily (primary, required)
TAVILY_API_KEY=tvly-your-tavily-api-key
# Search - Bing (fallback, optional)
BING_API_KEY=
# Search - Google Custom Search (fallback, optional)
GOOGLE_API_KEY=
GOOGLE_CX=

# Database - "auto" tries MySQL first, falls back to SQLite
# Set to "sqlite" to force SQLite, "mysql" to force MySQL
DB_TYPE=auto

# MySQL (optional - only needed if DB_TYPE=mysql or auto with MySQL available)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=ai_lead_generation

# Agent
DEFAULT_LLM=openai
DEFAULT_MODEL=gpt-4o
TEMPERATURE=0.3
MAX_SEARCH_RESULTS=20

# Demo Mode
DEMO_MODE=false
